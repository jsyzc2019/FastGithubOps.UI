<Window x:Class="FastGithub.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" SizeToContent="Height" Width="380" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <CheckBox x:Name="AutoStartCheckBox" Content="登录时以管理员身份启动" Grid.Row="0"/>
        <TextBlock x:Name="AutoStartHint" Grid.Row="1" TextWrapping="Wrap" Margin="18,4,0,12"
                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
        <CheckBox x:Name="StartMinimizedCheckBox" Content="启动后最小化" Grid.Row="2" Margin="0,0,0,12"/>
        <Button Content="确定" Grid.Row="3" HorizontalAlignment="Right" Width="75" Click="OkButton_Click"/>
    </Grid>
</Window>
